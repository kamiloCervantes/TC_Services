<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if purpose == 'password_reset' %}Restablecer Contraseña{% else %}Código de Verificación{% endif %} - {{ site_name }}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f6f8; padding: 40px 10px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" max-width="560" style="max-width: 560px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.06);">
          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 32px 24px; text-align: center;">
              <h1 style="color: #ffffff; font-size: 24px; font-weight: 700; margin: 0; letter-spacing: -0.5px;">
                {{ site_name }}
              </h1>
            </td>
          </tr>
          <!-- Body Content -->
          <tr>
            <td style="padding: 36px 32px; color: #334155; line-height: 1.6;">
              <h2 style="font-size: 20px; font-weight: 600; color: #0f172a; margin-top: 0; margin-bottom: 12px;">
                ¡Hola {{ recipient_name }}!
              </h2>
              {% if purpose == 'password_reset' %}
              <p style="font-size: 15px; margin-bottom: 24px;">
                Hemos recibido una solicitud para restablecer la contraseña de tu cuenta. Ingresa el siguiente código de verificación de 6 dígitos para continuar:
              </p>
              {% else %}
              <p style="font-size: 15px; margin-bottom: 24px;">
                Gracias por registrarte. Para completar la activación de tu cuenta, ingresa el siguiente código de verificación de 6 dígitos en la aplicación:
              </p>
              {% endif %}

              <!-- OTP Box -->
              <div style="text-align: center; margin: 32px 0;">
                <div style="display: inline-block; background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 8px; padding: 18px 36px; letter-spacing: 8px; font-size: 32px; font-weight: 700; color: #0f172a; font-family: 'Courier New', Courier, monospace;">
                  {{ otp_code }}
                </div>
              </div>

              <p style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-align: center;">
                ⏳ Este código expira en <strong>{{ expires_minutes }} minutos</strong>.
              </p>
              {% if purpose == 'password_reset' %}
              <p style="font-size: 13px; color: #94a3b8; text-align: center; margin-top: 24px; margin-bottom: 0;">
                Si tú no solicitaste este cambio, puedes ignorar este correo de manera segura. Tu contraseña actual permanecerá intacta.
              </p>
              {% else %}
              <p style="font-size: 13px; color: #94a3b8; text-align: center; margin-top: 24px; margin-bottom: 0;">
                Si tú no solicitaste este registro, puedes ignorar este correo de manera segura.
              </p>
              {% endif %}
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 20px; text-align: center; border-top: 1px solid #e2e8f0; font-size: 12px; color: #94a3b8;">
              &copy; {{ 'now'|date('Y') }} {{ site_name }}. Todos los derechos reservados.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
