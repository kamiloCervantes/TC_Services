<?php

/**
 * @file
 * Install, update, and uninstall functions for the tc_api_v1 module.
 */

/**
 * Implements hook_schema().
 */
function tc_api_v1_schema() {
  $schema['tc_article_comments'] = [
    'description' => 'Almacena los comentarios de los usuarios en las noticias.',
    'fields' => [
      'id' => [
        'description' => 'Clave primaria autoincremental del comentario.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'description' => 'ID de la noticia (nodo) a la que pertenece el comentario.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'uid' => [
        'description' => 'ID del usuario autor del comentario. No permitido valor nulo/vacío.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'message' => [
        'description' => 'Texto del mensaje del comentario.',
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Fecha y hora de creación en formato Unix timestamp.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'ip_address' => [
        'description' => 'Dirección IP desde la cual se publicó el comentario.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => TRUE,
        'default' => '',
      ],
      'status' => [
        'description' => 'Estado de publicación: 1 para publicado, 0 para moderado.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'nid_status_created' => ['nid', 'status', 'created'],
      'uid' => ['uid'],
      'created' => ['created'],
    ],
  ];

  $schema['tc_article_likes'] = [
    'description' => 'Almacena el detalle de los likes de los usuarios en las noticias.',
    'fields' => [
      'id' => [
        'description' => 'Clave primaria autoincremental del like.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'description' => 'ID de la noticia (nodo) a la que pertenece el like.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'uid' => [
        'description' => 'ID del usuario que dio like (0 para usuarios anónimos o no autenticados).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'user_name' => [
        'description' => 'Nombre del usuario o identificador de cliente para combinar con IP.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'ip_address' => [
        'description' => 'Dirección IP desde la cual se dio el like.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => TRUE,
        'default' => '',
      ],
      'user_agent' => [
        'description' => 'User Agent del navegador o cliente.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'default' => '',
      ],
      'created' => [
        'description' => 'Fecha y hora de creación en formato Unix timestamp.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'nid' => ['nid'],
      'nid_uid' => ['nid', 'uid'],
      'nid_ip' => ['nid', 'ip_address'],
      'nid_user_ip' => ['nid', 'user_name', 'ip_address'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Crea la tabla tc_article_comments en la base de datos para almacenar comentarios de noticias.
 */
function tc_api_v1_update_10001() {
  $schema = tc_api_v1_schema();
  $database = \Drupal::database();
  $schema_manager = $database->schema();

  if (!$schema_manager->tableExists('tc_article_comments')) {
    $schema_manager->createTable('tc_article_comments', $schema['tc_article_comments']);
    return \Drupal::translation()->translate('Tabla tc_article_comments creada exitosamente.');
  }

  return \Drupal::translation()->translate('La tabla tc_article_comments ya existe en la base de datos.');
}

/**
 * Crea el campo Total comentarios (field_total_comentarios) en el tipo de contenido news.
 */
function tc_api_v1_update_10002() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // 1. Almacenamiento del campo (FieldStorageConfig)
  $field_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_total_comentarios');
  if (!$field_storage) {
    $field_storage = \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_total_comentarios',
      'entity_type' => 'node',
      'type' => 'integer',
      'cardinality' => 1,
      'settings' => [
        'unsigned' => TRUE,
      ],
    ]);
    $field_storage->save();
  }

  // 2. Instancia del campo en el tipo de contenido news (FieldConfig)
  $field = \Drupal\field\Entity\FieldConfig::loadByName('node', 'news', 'field_total_comentarios');
  if (!$field) {
    $field = \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => 'news',
      'label' => 'Total comentarios',
      'description' => 'Total de comentarios registrados para esta noticia.',
      'default_value' => [['value' => 0]],
      'settings' => [
        'min' => 0,
      ],
    ]);
    $field->save();
  }

  // 3. Configurar formulario para edición
  $form_display = $entity_type_manager->getStorage('entity_form_display')->load('node.news.default');
  if ($form_display) {
    $form_display->setComponent('field_total_comentarios', [
      'type' => 'number',
      'weight' => 20,
    ])->save();
  }

  // 4. Configurar visualización
  $view_display = $entity_type_manager->getStorage('entity_view_display')->load('node.news.default');
  if ($view_display) {
    $view_display->setComponent('field_total_comentarios', [
      'type' => 'number_integer',
      'label' => 'above',
      'weight' => 20,
    ])->save();
  }

  // 5. Inicializar conteo para nodos existentes si ya hay comentarios en la tabla
  $database = \Drupal::database();
  if ($database->schema()->tableExists('tc_article_comments')) {
    $query = $database->select('tc_article_comments', 'c');
    $query->fields('c', ['nid']);
    $query->addExpression('COUNT(c.id)', 'total');
    $query->condition('c.status', 1);
    $query->groupBy('c.nid');
    $results = $query->execute()->fetchAll();

    $node_storage = $entity_type_manager->getStorage('node');
    foreach ($results as $row) {
      $node = $node_storage->load($row->nid);
      if ($node && $node->bundle() === 'news' && $node->hasField('field_total_comentarios')) {
        $node->set('field_total_comentarios', (int) $row->total);
        $node->save();
      }
    }
  }

  return \Drupal::translation()->translate('Campo Total comentarios (field_total_comentarios) creado y configurado exitosamente.');
}

/**
 * Crea la tabla tc_article_likes en la base de datos para almacenar el detalle de los likes.
 */
function tc_api_v1_update_10003() {
  $schema = tc_api_v1_schema();
  $database = \Drupal::database();
  $schema_manager = $database->schema();

  if (!$schema_manager->tableExists('tc_article_likes')) {
    $schema_manager->createTable('tc_article_likes', $schema['tc_article_likes']);
    return \Drupal::translation()->translate('Tabla tc_article_likes creada exitosamente.');
  }

  return \Drupal::translation()->translate('La tabla tc_article_likes ya existe en la base de datos.');
}

/**
 * Agrega el campo user_name a la tabla tc_article_likes para validar likes combinando usuario e IP.
 */
function tc_api_v1_update_10004() {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('tc_article_likes') && !$schema->fieldExists('tc_article_likes', 'user_name')) {
    $schema->addField('tc_article_likes', 'user_name', [
      'description' => 'Nombre del usuario o identificador de cliente para combinar con IP.',
      'type' => 'varchar',
      'length' => 128,
      'not null' => TRUE,
      'default' => '',
    ]);

    $schema->addIndex('tc_article_likes', 'nid_user_ip', ['nid', 'user_name', 'ip_address'], [
      'fields' => [
        'nid' => ['nid'],
        'user_name' => ['user_name'],
        'ip_address' => ['ip_address'],
      ],
    ]);

    return \Drupal::translation()->translate('Campo user_name agregado a tc_article_likes exitosamente.');
  }

  return \Drupal::translation()->translate('El campo user_name ya existe.');
}
